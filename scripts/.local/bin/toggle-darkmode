#!/bin/bash

# Runtime state shared with hyprland.lua (theme + powermode)
STATE=~/.config/hypr/state
[ -f "$STATE" ] || printf 'theme=gruvbox\npowermode=normal\n' > "$STATE"

set_hypr_theme() {  # $1 = theme name (gruvbox|flatwhite|black)
  sed -i "s/^theme=.*/theme=$1/" "$STATE"
}

# Theme toggle is disabled while in eco mode — eco owns the black theme
if grep -q '^powermode=eco' "$STATE"; then
  exit 0
fi

CURRENT=$(dconf read /org/gnome/desktop/interface/color-scheme)
if [[ "$CURRENT" == "'prefer-dark'" ]]; then
  # Switch to light
  dconf write /org/gnome/desktop/interface/color-scheme "'default'"
  emacsclient -e "(my/set-theme 'doom-flatwhite)" 2>/dev/null
  ln -sf flatwhite.css ~/.config/waybar/style.css
  killall -SIGUSR2 waybar
  # Kitty
  ln -sf flatwhite.conf ~/.config/kitty/current-theme.conf
  for sock in "$XDG_RUNTIME_DIR"/kitty-*; do
    kitty @ --to unix:"$sock" set-colors --all --configured ~/.config/kitty/flatwhite.conf 2>/dev/null
  done
  # Hyprland
  set_hypr_theme flatwhite
  hyprctl reload 2>/dev/null
  gsettings set org.gnome.desktop.interface gtk-theme Flatwhite
else
  # Switch to dark
  dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'"
  emacsclient -e "(my/set-theme 'doom-gruvbox)" 2>/dev/null
  ln -sf gruvbox.css ~/.config/waybar/style.css
  killall -SIGUSR2 waybar
  # Kitty
  ln -sf gruvbox.conf ~/.config/kitty/current-theme.conf
  for sock in "$XDG_RUNTIME_DIR"/kitty-*; do
    kitty @ --to unix:"$sock" set-colors --all --configured ~/.config/kitty/gruvbox.conf 2>/dev/null
  done
  # Hyprland
  set_hypr_theme gruvbox
  hyprctl reload 2>/dev/null
  gsettings set org.gnome.desktop.interface gtk-theme Gruvbox
fi
